# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
BOT_PREFIX=!
COMMAND_PREFIX=/

# Optional API Keys (add as needed)
STEAM_API_KEY=your_steam_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
FORMULA1_API_KEY=your_f1_api_key_here
SPORTS_API_KEY=your_sports_api_key_here
LEETIFY_API_KEY=your_leetify_api_key_here

# Bot Settings
DEBUG_MODE=False
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite:///data/database.db

# Economy Settings
STARTING_BALANCE=1000
DAILY_REWARD=100
WORK_REWARD_MIN=50
WORK_REWARD_MAX=200

# Study Settings
DEFAULT_STUDY_DURATION=25
DEFAULT_BREAK_DURATION=5

# Server Settings
DEFAULT_WELCOME_CHANNEL=general
AUTO_ROLE_ENABLED=False
